# Copy to .env and fill in for local development.
# Local Postgres (Homebrew): postgres://<macos-username>@localhost:5432/exercise_partner_dev
DATABASE_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shared password protecting the whole site. Choose your own — do not reuse
# a password used anywhere else, since it is stored in plain text in .env.
SITE_PASSWORD=

# Second secret required by /admin, on top of SITE_PASSWORD. Everyone using
# the site knows SITE_PASSWORD, so this is what separates the site owner from
# the other people sharing it — keep it out of the password everyone has.
# The admin gate refuses to run if this is unset rather than falling back to
# a default, so /admin is unreachable until you fill it in.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=
