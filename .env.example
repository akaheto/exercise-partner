# Copy to .env and fill in for local development.
# Local Postgres (Homebrew): postgres://<macos-username>@localhost:5432/exercise_partner_dev
DATABASE_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shared password protecting the whole site. Choose your own — do not reuse
# a password used anywhere else, since it is stored in plain text in .env.
SITE_PASSWORD=
